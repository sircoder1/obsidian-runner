PORT=4173
HOST=127.0.0.1

# preview: streams a safe simulated job so the interface can be reviewed.
# docker: clones exact commits and runs them in disposable Linux containers.
# local: clones and executes student repositories directly on this machine.
RUNNER_MODE=preview
ALLOW_LOCAL_EXECUTION=false
ALLOW_DOCKER_EXECUTION=false
PYTHON_EXECUTABLE=python3

DOCKER_EXECUTABLE=docker
DOCKER_RUNNER_IMAGE=obsidian-runner-python:latest
DOCKER_NETWORK=obsidian-lab
DOCKER_MEMORY=384m
DOCKER_CPUS=1.0
DOCKER_PIDS_LIMIT=128

JOB_TIMEOUT_MS=120000
MAX_REPO_BYTES=104857600
MAX_OUTPUT_BYTES=26214400

# Optional absolute overrides for Linux mounts or isolated QA instances.
# DATA_DIR=/var/lib/obsidian-runner
# JOBS_DIR=/var/lib/obsidian-runner/jobs
