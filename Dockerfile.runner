FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        iproute2 \
        iputils-ping \
        libxcb1 \
        net-tools \
        procps \
        util-linux \
        xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install \
        "paramiko>=3.5,<5" \
        "Pillow>=11,<13" \
        "psutil>=6,<8" \
    && useradd --create-home --uid 10001 --shell /bin/bash runner

COPY --chmod=0555 docker/runner-entrypoint.py /opt/obsidian-runner/runner-entrypoint.py

USER runner
WORKDIR /workspace/repo

ENTRYPOINT ["python3", "/opt/obsidian-runner/runner-entrypoint.py"]
